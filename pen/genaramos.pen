                {
                  "type": "text",
                  "id": "di620",
                  "name": "Há mais de 30 anos que t",
                  "fill": "$muted",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Há mais de 30 anos que trabalho com cabelos para cinema, teatro, televisão e todo o tipo de eventos. Do penteado de época ao visual contemporâneo, cada trabalho começa por perceber a personagem — ou a pessoa — que está na cadeira.",
